# Aplicación
APP_NAME=Datilera
ENVIRONMENT=dev
DEBUG=true

# Base de datos y colas
DATABASE_URL=mysql+aiomysql://usuario:contrasena@localhost:3306/datilera
REDIS_URL=redis://localhost:6379/0

# Seguridad: generar un valor aleatorio de al menos 32 caracteres
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Orígenes separados por coma. No usar * con credenciales.
CORS_ORIGINS=http://localhost:8000
TRUSTED_HOSTS=localhost,127.0.0.1

# Archivos
STATIC_DIR=app/interfaces/web/static
TEMPLATES_DIR=app/interfaces/web/templates
MEDIA_DIR=media
PDF_DIR=pdfs

# Servicios externos
GEMINI_API_KEY=reemplazar
GEMINI_MODEL=gemini-2.5-flash

# SQLAlchemy
SQL_ECHO=0
SQL_POOL_SIZE=10
SQL_MAX_OVERFLOW=20
SQL_POOL_TIME_OUT=30
SQL_POOL_RECYCLE=1800
